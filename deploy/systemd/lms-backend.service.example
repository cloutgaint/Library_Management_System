[Unit]
Description=Library LMS API
After=network-online.target postgresql.service
Wants=network-online.target
[Service]
Type=simple
User=lms
Group=lms
WorkingDirectory=/opt/lms/backend
EnvironmentFile=/etc/lms/backend.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/lms/backend/uploads
[Install]
WantedBy=multi-user.target
