NODE_ENV=production
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=lms
DB_USER=lms
DB_PASSWORD=REPLACE_IN_SECRET_STORE
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
CORS_ORIGINS=https://example.org
EMAIL_USER=
EMAIL_PASSWORD=

# Absolute frontend reset URL, e.g. https://example.org/reset-password
RESET_URL_BASE=https://example.org/reset-password

# Login/register/password-recovery attempts allowed per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=30

# Integration tests (npm run test:integration) recreate this database. Must end in _test.
TEST_DB_NAME=lms_test
